SELECT *
FROM categorias;

SELECT *
FROM proveedores;

SELECT *
FROM usuarios;

SELECT *
FROM productos;

SELECT *
FROM movimientos_inventario;

SELECT
    p.id_producto,
    p.nombre,
    COALESCE(
        SUM(
            CASE
                WHEN m.tipo_movimiento = 'E' THEN m.cantidad
                WHEN m.tipo_movimiento = 'S' THEN -m.cantidad
            END
        ),
        0
    ) AS stock_actual
FROM productos AS p
LEFT JOIN movimientos_inventario AS m
    ON p.id_producto = m.id_producto
GROUP BY
    p.id_producto,
    p.nombre
ORDER BY
    p.id_producto;

SELECT
    p.id_producto,
    p.nombre AS producto,
    p.sku,
    c.nombre AS categoria,
    pr.nombre_razon_social AS proveedor,
    p.precio_compra,
    p.precio_venta,
    p.stock_minimo
FROM productos AS p
INNER JOIN categorias AS c
    ON p.id_categoria = c.id_categoria
LEFT JOIN proveedores AS pr
    ON p.id_proveedor = pr.id_proveedor
ORDER BY
    p.id_producto;
